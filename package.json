{
  "name": "wren-writing-coach",
  "version": "0.0.0",
  "private": true,
  "description": "WREN Writing Coach monorepo — shared test tooling (Jest + ts-jest + fast-check)",
  "license": "MIT",
  "workspaces": [
    "types",
    "backend/database/node",
    "backend/auth",
    "backend/admin",
    "backend/document",
    "backend/feedback",
    "backend/notification"
  ],
  "scripts": {
    "deploy": "node scripts/wren-ops.mjs deploy",
    "undeploy": "node scripts/wren-ops.mjs undeploy",
    "disarm": "node scripts/wren-ops.mjs disarm",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint:appname": "node scripts/check-app-name.mjs",
    "test:ci": "node scripts/check-app-name.mjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --silent"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "esbuild": "^0.28.1",
    "fast-check": "3.23.2",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "optionalDependencies": {
    "@ast-grep/lang-bash": "^0.0.8",
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-csharp": "^0.0.6",
    "@ast-grep/lang-dart": "^0.0.7",
    "@ast-grep/lang-elixir": "^0.0.7",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-haskell": "^0.0.7",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-lua": "^0.0.7",
    "@ast-grep/lang-php": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-scala": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.44.0",
    "@firecrawl/pdf-inspector": "^1.9.8"
  }
}
